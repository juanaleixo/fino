---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fino - Performance e SEO">
  <section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
          Bem-vindo ao <span class="text-blue-600">Fino</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Projeto web moderno construído com Astro 4.x, focado em performance, SEO e experiência do usuário.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/sobre"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            Saiba Mais
          </a>
          <a
            href="/contato"
            class="border border-blue-600 text-blue-600 hover:bg-blue-50 font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            Entre em Contato
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Performance</h3>
          <p class="text-gray-600">
            Otimizado para velocidade com Astro e técnicas modernas de web performance.
          </p>
        </div>
        
        <div class="text-center">
          <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">SEO</h3>
          <p class="text-gray-600">
            Estrutura otimizada para motores de busca com metadados e semântica adequada.
          </p>
        </div>
        
        <div class="text-center">
          <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Responsivo</h3>
          <p class="text-gray-600">
            Design adaptável que funciona perfeitamente em todos os dispositivos.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Estilos inline para funcionar sem Tailwind */
  .bg-gradient-to-br {
    background: linear-gradient(to bottom right, #eff6ff, #e0e7ff);
  }
  
  .from-blue-50 {
    background-color: #eff6ff;
  }
  
  .to-indigo-100 {
    background-color: #e0e7ff;
  }
  
  .py-20 {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  
  .max-w-7xl {
    max-width: 80rem;
  }
  
  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
  
  .px-4 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  .sm\\:px-6 {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  
  .lg\\:px-8 {
    padding-left: 2rem;
    padding-right: 2rem;
  }
  
  .text-center {
    text-align: center;
  }
  
  .text-4xl {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  
  .md\\:text-6xl {
    font-size: 3.75rem;
    line-height: 1;
  }
  
  .font-bold {
    font-weight: 700;
  }
  
  .text-gray-900 {
    color: #111827;
  }
  
  .mb-6 {
    margin-bottom: 1.5rem;
  }
  
  .text-blue-600 {
    color: #2563eb;
  }
  
  .text-xl {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  
  .text-gray-600 {
    color: #4b5563;
  }
  
  .mb-8 {
    margin-bottom: 2rem;
  }
  
  .max-w-3xl {
    max-width: 48rem;
  }
  
  .flex {
    display: flex;
  }
  
  .flex-col {
    flex-direction: column;
  }
  
  .sm\\:flex-row {
    flex-direction: row;
  }
  
  .gap-4 {
    gap: 1rem;
  }
  
  .justify-center {
    justify-content: center;
  }
  
  .bg-blue-600 {
    background-color: #2563eb;
  }
  
  .hover\\:bg-blue-700:hover {
    background-color: #1d4ed8;
  }
  
  .text-white {
    color: white;
  }
  
  .font-semibold {
    font-weight: 600;
  }
  
  .py-3 {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }
  
  .px-8 {
    padding-left: 2rem;
    padding-right: 2rem;
  }
  
  .rounded-lg {
    border-radius: 0.5rem;
  }
  
  .transition-colors {
    transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }
  
  .border {
    border-width: 1px;
  }
  
  .border-blue-600 {
    border-color: #2563eb;
  }
  
  .hover\\:bg-blue-50:hover {
    background-color: #eff6ff;
  }
  
  .py-16 {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  
  .bg-white {
    background-color: white;
  }
  
  .grid {
    display: grid;
  }
  
  .grid-cols-1 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  
  .md\\:grid-cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  
  .gap-8 {
    gap: 2rem;
  }
  
  .bg-blue-100 {
    background-color: #dbeafe;
  }
  
  .w-16 {
    width: 4rem;
  }
  
  .h-16 {
    height: 4rem;
  }
  
  .rounded-full {
    border-radius: 9999px;
  }
  
  .flex {
    display: flex;
  }
  
  .items-center {
    align-items: center;
  }
  
  .justify-center {
    justify-content: center;
  }
  
  .mb-4 {
    margin-bottom: 1rem;
  }
  
  .w-8 {
    width: 2rem;
  }
  
  .h-8 {
    height: 2rem;
  }
  
  .bg-green-100 {
    background-color: #dcfce7;
  }
  
  .text-green-600 {
    color: #16a34a;
  }
  
  .bg-purple-100 {
    background-color: #f3e8ff;
  }
  
  .text-purple-600 {
    color: #9333ea;
  }
  
  @media (min-width: 768px) {
    .md\\:text-6xl {
      font-size: 3.75rem;
      line-height: 1;
    }
    
    .md\\:grid-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    
    .sm\\:flex-row {
      flex-direction: row;
    }
  }
</style> 