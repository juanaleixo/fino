---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fino - Plataforma de Cobran\u00e7a Autom\u00e1tica">
  <section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
          Fature e cobre automaticamente com o <span class="text-blue-600">Fino</span>
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Simplifique a emiss\u00e3o de faturas e reduza a inadimpl\u00eancia com lembretes por e-mail, WhatsApp e SMS.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#pricing" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors">
            Garanta seu acesso beta
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h6v6H3zM15 3h6v6h-6zM15 15h6v6h-6zM3 15h6v6H3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Faturas Autom\u00e1ticas</h3>
          <p class="text-gray-600">Emita e envie cobran\u00e7as recorrentes sem esfor\u00e7o.</p>
        </div>

        <div class="text-center">
          <div class="bg-green-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8s-9-3.582-9-8 4.03-8 9-8 9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Cobran\u00e7a Multicanal</h3>
          <p class="text-gray-600">Lembretes por e-mail, WhatsApp e SMS.</p>
        </div>

        <div class="text-center">
          <div class="bg-purple-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 6h18M9 14h6M12 18h.01" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Integra\u00e7\u00f5es de Pagamento</h3>
          <p class="text-gray-600">Conecte Stripe, PayPal, Mercado Pago ou PIX.</p>
        </div>

        <div class="text-center">
          <div class="bg-yellow-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4h16v16H4z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Templates Personaliz\u00e1veis</h3>
          <p class="text-gray-600">Faturas profissionais com sua identidade visual.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Planos</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border rounded-lg p-6 text-center">
          <h3 class="text-xl font-semibold mb-4">B\u00e1sico</h3>
          <p class="text-gray-600 mb-6">US$9/m\u00eas at\u00e9 50 faturas</p>
          <a href="#contato" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">Assinar</a>
        </div>
        <div class="border rounded-lg p-6 text-center">
          <h3 class="text-xl font-semibold mb-4">Intermedi\u00e1rio</h3>
          <p class="text-gray-600 mb-6">US$19/m\u00eas at\u00e9 200 faturas + WhatsApp</p>
          <a href="#contato" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">Assinar</a>
        </div>
        <div class="border rounded-lg p-6 text-center">
          <h3 class="text-xl font-semibold mb-4">Avan\u00e7ado</h3>
          <p class="text-gray-600 mb-6">US$49/m\u00eas faturas ilimitadas e integra\u00e7\u00f5es</p>
          <a href="#contato" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">Assinar</a>
        </div>
      </div>
    </div>
  </section>

  <section id="contato" class="py-16 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Fale Conosco</h2>
      <p class="text-gray-600 mb-6">Interessado em testar o Fino? Envie seu e-mail e entraremos em contato.</p>
      <a href="mailto:contato@example.com" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition-colors">Enviar e-mail</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Estilos inline para funcionar sem Tailwind */
  .bg-gradient-to-br {
    background: linear-gradient(to bottom right, #eff6ff, #e0e7ff);
  }
  .from-blue-50 {
    background-color: #eff6ff;
  }
  .to-indigo-100 {
    background-color: #e0e7ff;
  }
  .py-20 { padding-top: 5rem; padding-bottom: 5rem; }
  .py-16 { padding-top: 4rem; padding-bottom: 4rem; }
  .max-w-7xl { max-width: 80rem; }
  .max-w-2xl { max-width: 42rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .px-4 { padding-left: 1rem; padding-right: 1rem; }
  .sm\:px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
  .lg\:px-8 { padding-left: 2rem; padding-right: 2rem; }
  .text-center { text-align: center; }
  .text-4xl { font-size: 2.25rem; line-height: 2.5rem; }
  .text-3xl { font-size: 1.875rem; line-height: 2.25rem; }
  .md\:text-6xl { font-size: 3.75rem; line-height: 1; }
  .font-bold { font-weight: 700; }
  .font-semibold { font-weight: 600; }
  .text-gray-900 { color: #111827; }
  .text-gray-600 { color: #4b5563; }
  .text-blue-600 { color: #2563eb; }
  .text-yellow-600 { color: #ca8a04; }
  .mb-2 { margin-bottom: 0.5rem; }
  .mb-4 { margin-bottom: 1rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  .mb-8 { margin-bottom: 2rem; }
  .mb-12 { margin-bottom: 3rem; }
  .flex { display: flex; }
  .flex-col { flex-direction: column; }
  .sm\:flex-row { flex-direction: row; }
  .gap-4 { gap: 1rem; }
  .gap-8 { gap: 2rem; }
  .justify-center { justify-content: center; }
  .grid { display: grid; }
  .grid-cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
  .md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .md\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .border { border-width: 1px; border-color: #e5e7eb; }
  .rounded-lg { border-radius: 0.5rem; }
  .p-6 { padding: 1.5rem; }
  .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }
  .px-8 { padding-left: 2rem; padding-right: 2rem; }
  .px-4 { padding-left: 1rem; padding-right: 1rem; }
  .rounded-full { border-radius: 9999px; }
  .w-16 { width: 4rem; }
  .h-16 { height: 4rem; }
  .w-8 { width: 2rem; }
  .h-8 { height: 2rem; }
  .bg-blue-100 { background-color: #dbeafe; }
  .bg-green-100 { background-color: #dcfce7; }
  .bg-purple-100 { background-color: #f3e8ff; }
  .bg-yellow-100 { background-color: #fef9c3; }
  .bg-gray-50 { background-color: #f9fafb; }
  .bg-white { background-color: #ffffff; }
  .bg-blue-600 { background-color: #2563eb; }
  .hover\:bg-blue-700:hover { background-color: #1d4ed8; }
  .text-white { color: white; }
  .transition-colors { transition-property: color, background-color, border-color, text-decoration-color, fill, stroke; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); transition-duration: 150ms; }
  @media (min-width: 768px) {
    .md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .md\:grid-cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sm\:flex-row { flex-direction: row; }
    .md\:text-6xl { font-size: 3.75rem; line-height: 1; }
  }
</style>
