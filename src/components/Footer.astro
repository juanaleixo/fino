---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-50 border-t">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Fino</h3>
        <p class="text-gray-600 text-sm">
          Plataforma de faturamento e cobrança automática.
        </p>
      </div>
      
      <div>
        <h4 class="text-sm font-semibold text-gray-900 mb-4">Links</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-600 hover:text-gray-900 text-sm">Início</a></li>
          <li><a href="#features" class="text-gray-600 hover:text-gray-900 text-sm">Recursos</a></li>
          <li><a href="#pricing" class="text-gray-600 hover:text-gray-900 text-sm">Planos</a></li>
          <li><a href="#contato" class="text-gray-600 hover:text-gray-900 text-sm">Contato</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="text-sm font-semibold text-gray-900 mb-4">Tecnologias</h4>
        <ul class="space-y-2">
          <li class="text-gray-600 text-sm">Astro 4.x</li>
          <li class="text-gray-600 text-sm">TypeScript</li>
          <li class="text-gray-600 text-sm">Tailwind CSS</li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 pt-8 border-t border-gray-200">
      <p class="text-center text-gray-500 text-sm">
        © {currentYear} Fino. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Estilos inline para funcionar sem Tailwind */
  footer {
    background-color: #f9fafb;
    border-top: 1px solid #e5e7eb;
  }
  
  .max-w-7xl {
    max-width: 80rem;
  }
  
  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }
  
  .py-12 {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  
  .px-4 {
    padding-left: 1rem;
    padding-right: 1rem;
  }
  
  .sm\\:px-6 {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  
  .lg\\:px-8 {
    padding-left: 2rem;
    padding-right: 2rem;
  }
  
  .grid {
    display: grid;
  }
  
  .grid-cols-1 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
  
  .md\\:grid-cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  
  .gap-8 {
    gap: 2rem;
  }
  
  .text-lg {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  
  .font-semibold {
    font-weight: 600;
  }
  
  .text-gray-900 {
    color: #111827;
  }
  
  .mb-4 {
    margin-bottom: 1rem;
  }
  
  .text-gray-600 {
    color: #4b5563;
  }
  
  .text-sm {
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  
  .space-y-2 > * + * {
    margin-top: 0.5rem;
  }
  
  .hover\\:text-gray-900:hover {
    color: #111827;
  }
  
  .mt-8 {
    margin-top: 2rem;
  }
  
  .pt-8 {
    padding-top: 2rem;
  }
  
  .border-t {
    border-top: 1px solid #e5e7eb;
  }
  
  .border-gray-200 {
    border-color: #e5e7eb;
  }
  
  .text-center {
    text-align: center;
  }
  
  .text-gray-500 {
    color: #6b7280;
  }
  
  @media (min-width: 768px) {
    .md\\:grid-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style> 